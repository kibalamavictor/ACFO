# Required in production (the CMS refuses to sign anyone in without them).
# CMS_PASSWORD: 8+ characters; only used to create the first administrator.
# CMS_SECRET: 32+ random characters, e.g. `openssl rand -base64 48`. It signs sessions
# and encrypts the editor list in Blob, so changing it signs everyone out and makes
# only the CMS_ADMIN_EMAIL account usable until editors are re-added.
CMS_ADMIN_EMAIL=admin@acfo.org
CMS_PASSWORD=African@Child@2026
CMS_SECRET=M9MfJHCjEG2Ciz22H8J1PteFEj7RPLH8kc6OoY62RzA=
BLOB_READ_WRITE_TOKEN=

# Public site URL used for canonical links, sitemap, Open Graph, and RSS.
NEXT_PUBLIC_SITE_URL=https://acfo-pi.vercel.app

# Optional search-console verification tokens (meta tags).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
